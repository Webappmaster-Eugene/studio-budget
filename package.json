{
  "name": "studio-budget",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "HOSTNAME=127.0.0.1 node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests --maxWorkers=2",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node -e \"require('node:fs').cpSync('.next/static', '.next/standalone/.next/static', { recursive: true })\"",
    "smoke": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/golos-text": "5.3.0",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
